  "hero": {
    "title": "Audio Driven Video",
    "summary": "Pair a reusable avatar with uploaded audio to create a lip-synced AI video. Returns an asynchronous generation task and video URL for narration, voiceovers, and localized content."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/generate/video/audio_driven",
    "summary": "Create an avatar video from a source audio file and reusable avatar."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Prepare avatar and audio assets before calling this endpoint.",
      "Requires avatar_asset_id from your Media Assets or official public assets, plus audio_file_id.",
      "Also accepts optional duration_seconds, links, clarity, aspect_ratio, and model."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "aspect_ratio",
        "type": "string",
        "description": "Requested output aspect ratio, for example 16:9 or 9:16.",
        "location": "BODY"
      },
      {
        "name": "audio_file_id",
        "type": "string",
        "required": true,
        "location": "BODY"
      },
      {
        "name": "avatar_asset_id",
        "type": "string",
        "required": true,
        "description": "Reusable avatar asset ID owned by the current user or listed as an official public asset.",
        "location": "BODY"
      },
      {
        "name": "clarity",
        "type": "string",
        "description": "Requested output clarity, for example 1080P or 2K.",
        "location": "BODY"
      },
      {
        "name": "duration_seconds",
        "type": "int32",
        "description": "Requested output duration in seconds.",
        "location": "BODY"
      },
      {
        "name": "links",
        "type": "array<string>",
        "description": "Optional reference links collected from the Playground form.",
        "location": "BODY"
      },
      {
        "name": "model",
        "type": "string",
        "description": "Selected generation model label or version from the Playground form.",
        "location": "BODY"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Stable public Medux model identifier.",
        "location": "BODY"
      },
      {
        "name": "title",
        "type": "string",
        "location": "BODY"
      }
    ]
  },
