  "hero": {
    "title": "Get Creation Task",
    "summary": "Read the current state of a generation task."
  },
  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/generate/tasks/{task_id}",
    "summary": "Return the current state of a media generation task."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires a task_id returned by a generation request.",
      "Use this for polling any generation task created under the Generate module."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "task_id",
        "type": "string",
        "required": true,
        "location": "PATH"
      }
    ]
  },
  "response_section": {
