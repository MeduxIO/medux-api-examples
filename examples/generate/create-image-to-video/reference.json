  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/generate/video/image_to_video \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"aspect_ratio\":\"ASPECT_RATIO\",\"clarity\":\"CLARITY\",\"duration_seconds\":1,\"file_id\":\"FILE_ID\",\"model_id\":\"MODEL_ID\",\"prompt\":\"PROMPT\",\"title\":\"Demo title\"}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/generate/video/image_to_video \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"aspect_ratio\":\"ASPECT_RATIO\",\"clarity\":\"CLARITY\",\"duration_seconds\":1,\"file_id\":\"FILE_ID\",\"model_id\":\"MODEL_ID\",\"prompt\":\"PROMPT\",\"title\":\"Demo title\"}'"
