  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/generate/video/image_to_video",
    "summary": "Generate a video from a source image and text prompt."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Choose an available model and enter a prompt.",
      "Provide exactly one uploaded image as file_id and a non-empty prompt.",
      "Read generation_options from the model catalog; only listed parameter values are accepted.",
      "Use clarity for output resolution. Estimate credits with the same parameters before submission."
    ]
  },
