  "hero": {
    "title": "Create Image to Video",
    "summary": "Generate a video from a source image and text prompt."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/generate/video/image_to_video",
    "summary": "Generate a video from a source image and text prompt."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source image and create a file reference before calling this endpoint.",
      "Requires an uploaded image file_id and a non-empty prompt.",
      "Also accepts optional duration_seconds, clarity, aspect_ratio, and model_id."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "aspect_ratio",
        "type": "string",
        "description": "Requested output aspect ratio, for example 16:9 or 9:16.",
        "location": "BODY"
      },
      {
        "name": "clarity",
        "type": "string",
        "description": "Requested output clarity, for example 720P or 1080P.",
