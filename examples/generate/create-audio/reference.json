  "hero": {
    "title": "Create Audio",
    "summary": "Generate speech audio from text with a reusable voice asset."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/generate/audio",
    "summary": "Generate speech audio from text using a reusable voice asset."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires a voice_asset_id.",
      "Requires voice_asset_id from your Media Assets or official public assets, plus non-empty text.",
      "Also accepts optional links and model."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "links",
        "type": "array<string>",
        "description": "Optional reference links submitted from the Playground form.",
        "location": "BODY"
      },
      {
        "name": "model",
        "type": "string",
        "description": "Generation model label or version selected in the Playground form.",
        "location": "BODY"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Stable public Medux model identifier.",
        "location": "BODY"
      },
      {
        "name": "text",
        "type": "string",
        "location": "BODY"
      },
      {
        "name": "title",
        "type": "string",
        "location": "BODY"
      },
      {
        "name": "voice_asset_id",
        "type": "string",
        "required": true,
        "description": "Reusable voice asset used for text-to-speech generation.",
        "location": "BODY"
      }
    ]
  },
