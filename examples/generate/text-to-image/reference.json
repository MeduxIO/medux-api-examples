  "hero": {
    "title": "Create Text to Image",
    "summary": "Generate an image from a text prompt."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/generate/image/text_to_image",
    "summary": "Generate an image from a text prompt."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires a valid Authorization header and the configured request body.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "prompt",
        "type": "string",
        "required": true,
        "description": "Prompt text used to generate the image.",
        "location": "BODY"
      },
      {
        "name": "negative_prompt",
        "type": "string",
        "description": "Optional negative prompt.",
        "location": "BODY"
      },
      {
        "name": "height",
        "type": "integer",
        "description": "Output image height. Default: 1024.",
        "location": "BODY",
        "default_value": "1024"
      },
      {
        "name": "width",
        "type": "integer",
        "description": "Output image width. Default: 1024.",
        "location": "BODY",
        "default_value": "1024"
      },
      {
        "name": "seed",
        "type": "integer",
        "description": "Random seed. Use -1 to auto-generate. Default: -1.",
        "location": "BODY",
        "default_value": "-1"
      },
      {
        "name": "num_inference_steps",
        "type": "integer",
        "description": "Number of inference steps. Default: 9.",
        "location": "BODY",
        "default_value": "9"
      },
      {
        "name": "guidance_scale",
        "type": "number",
        "description": "Guidance scale. Default: 0.0.",
        "location": "BODY",
        "default_value": "0.0"
      },
      {
        "name": "cfg_normalization",
        "type": "boolean",
        "description": "Whether to enable CFG normalization. Default: false.",
        "location": "BODY",
        "default_value": "false"
      },
      {
        "name": "cfg_truncation",
        "type": "number",
        "description": "CFG truncation value. Default: 1.0.",
        "location": "BODY",
        "default_value": "1.0"
      },
      {
        "name": "max_sequence_length",
        "type": "integer",
        "description": "Maximum text sequence length. Default: 512.",
        "location": "BODY",
        "default_value": "512"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Text-to-image model id. Default: text-to-image-default.",
        "location": "BODY",
        "default_value": "text-to-image-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "Application response code.\n\n| Code | Meaning |\n| ---- | ------- |\n| `0` | OK |\n| `12` | Invalid input |\n| `1401` | Insufficient credits |\n| `1404` | Provider returned an error |\n| `1405` | Provider request timed out |\n| `13` | Authentication is required |\n| `16` | Rate limit exceeded |\n| `99` | Server error |",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1410",
          "1409",
          "1401",
          "1404",
          "1405",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.paid_plan_required",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "invalid model",
          "paid plan required",
          "insufficient credits",
          "provider error",
          "provider timeout",
          "unauthenticated",
          "rate limit",
          "server error"
        ]
      }
    ]
  },
  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/generate/image/text_to_image \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"cfg_normalization\":false,\"cfg_truncation\":1,\"guidance_scale\":0,\"height\":1024,\"max_sequence_length\":512,\"model_id\":\"text-to-image-default\",\"num_inference_steps\":9,\"prompt\":\"PROMPT\",\"seed\":-1,\"width\":1024}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/generate/image/text_to_image \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"cfg_normalization\":false,\"cfg_truncation\":1,\"guidance_scale\":0,\"height\":1024,\"max_sequence_length\":512,\"model_id\":\"text-to-image-default\",\"num_inference_steps\":9,\"prompt\":\"PROMPT\",\"seed\":-1,\"width\":1024}'"
  },
