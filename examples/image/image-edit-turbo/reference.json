  "hero": {
    "title": "Image Edit Turbo",
    "summary": "Edit one or more images from a text prompt."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/generate/image/image_edit_turbo",
    "summary": "Edit one or more images from a text prompt."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload each source file and create file references before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "image_file_ids",
        "type": "array<string>",
        "required": true,
        "description": "Input image file_id list.",
        "location": "BODY"
      },
      {
        "name": "prompt",
        "type": "string",
        "required": true,
        "description": "Prompt text describing the requested image edit.",
        "location": "BODY"
      },
      {
        "name": "negative_prompt",
        "type": "string",
        "description": "Optional negative prompt.",
        "location": "BODY"
      },
      {
        "name": "height",
        "type": "integer",
        "description": "Output image height. Default: 1024.",
        "location": "BODY",
        "default_value": "1024"
      },
      {
        "name": "width",
        "type": "integer",
        "description": "Output image width. Default: 1024.",
        "location": "BODY",
        "default_value": "1024"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Image editing model id. Default: qwen-image-edit.",
        "location": "BODY",
        "enum_values": [
          "qwen-image-edit",
          "qwen-image-21",
          "minimax-h3-image"
        ],
        "default_value": "qwen-image-edit"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "response code enums:\\\n.. 0: ok\\\n.. 12: invalid input\\\n.. 1410: invalid model\\\n.. 1409: paid plan required\\\n.. 1401: insufficient credits\\\n.... 1401 ~ 1499 是 media\\\n.. 1404: provider error\\\n.. 1405: provider timeout\\\n.. 13: unauthenticated\\\n.. 16: rate limit\\\n.. 99: server error",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1410",
          "1409",
          "1401",
          "1404",
          "1405",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.paid_plan_required",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "invalid model",
          "paid plan required",
          "insufficient credits",
          "provider error",
          "provider timeout",
          "unauthenticated",
          "rate limit",
          "server error"
        ]
      }
    ]
  },
  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/generate/image/image_edit_turbo \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"height\":1024,\"image_file_ids\":[\"FILE_ID\"],\"model_id\":\"qwen-image-edit\",\"prompt\":\"PROMPT\",\"width\":1024}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/generate/image/image_edit_turbo \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"height\":1024,\"image_file_ids\":[\"FILE_ID\"],\"model_id\":\"qwen-image-edit\",\"prompt\":\"PROMPT\",\"width\":1024}'"
  },
