  "hero": {
    "title": "Trim Audio",
    "summary": "Cut an audio file to a specified time range."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/process/audio/trim_audio",
    "summary": "Cut an audio file to a specified time range."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "input_file_id",
        "type": "string",
        "required": true,
        "description": "Input audio file_id.",
        "location": "BODY"
      },
      {
        "name": "start_time",
        "type": "string",
        "description": "e.g. 00:00:05",
        "location": "BODY"
      },
      {
        "name": "end_time",
        "type": "string",
        "description": "e.g. 00:01:00",
        "location": "BODY"
      },
      {
        "name": "duration",
        "type": "string",
        "description": "e.g. 00:00:55. At least one of start_time/end_time/duration required.",
        "location": "BODY"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Model Default: trim-audio-default.",
        "location": "BODY",
        "default_value": "trim-audio-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
