    "request_example": "curl -X POST https://api.medux.io/api/app/v1/process/video/resize_video \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"height\":1,\"input_file_id\":\"FILE_ID\",\"model_id\":\"resize-video-default\",\"width\":1}'",
