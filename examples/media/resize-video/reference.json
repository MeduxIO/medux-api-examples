  "hero": {
    "title": "Resize Video",
    "summary": "Resize a video to a target resolution."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/process/video/resize_video",
    "summary": "Resize a video to a target resolution."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "input_file_id",
        "type": "string",
        "required": true,
        "description": "Input video file_id.",
        "location": "BODY"
      },
      {
        "name": "width",
        "type": "integer",
        "required": true,
        "description": "Output width in pixels.",
        "location": "BODY"
      },
      {
        "name": "height",
        "type": "integer",
        "required": true,
        "description": "Output height in pixels.",
        "location": "BODY"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Model Default: resize-video-default.",
        "location": "BODY",
        "default_value": "resize-video-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
