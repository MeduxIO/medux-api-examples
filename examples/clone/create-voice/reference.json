  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/clone/voice",
    "summary": "Create a reusable voice asset from an uploaded audio file."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires an uploaded source file_id.",
      "Use a clean speech sample for better identity consistency."
    ]
  },
