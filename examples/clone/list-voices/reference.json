  "hero": {
    "title": "List Voices",
    "summary": "List reusable voice assets for the current account."
  },
  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/clone/voices",
    "summary": "List reusable voice assets owned by the authenticated user."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Try it lists the current user's voice assets.",
      "Only voice assets are returned."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "cursor",
        "type": "string",
        "location": "QUERY"
      },
      {
        "name": "limit",
        "type": "int32",
        "location": "QUERY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "Application response code.\n\n| Code | Meaning |\n| ---- | ------- |\n| `0` | OK |\n| `12` | Invalid input |\n| `13` | Authentication is required |\n| `99` | Server error |",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "13",
          "99"
        ]
      },
      {
        "name": "data.items",
        "type": "array<object>",
        "location": "RESPONSE"
      },
      {
        "name": "data.next_cursor",
        "type": "string",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "unauthenticated",
          "server error"
        ]
      }
    ]
  },
