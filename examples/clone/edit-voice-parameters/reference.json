  "hero": {
    "title": "Edit Voice Parameters",
    "summary": "Adjust voice parameters for an existing reusable voice asset."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/clone/voice/{voice_asset_id}/parameters",
    "summary": "Update tuning parameters for an existing reusable voice asset."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires an existing voice_asset_id.",
      "Provide at least one change such as speed, tone, emotion, or title."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "voice_asset_id",
        "type": "string",
        "required": true,
        "location": "PATH"
      },
      {
        "name": "emotion",
        "type": "int32",
        "location": "BODY"
      },
      {
        "name": "speed",
        "type": "int32",
        "location": "BODY"
      },
      {
        "name": "title",
        "type": "string",
        "location": "BODY"
      },
      {
        "name": "tone",
        "type": "int32",
        "location": "BODY"
      }
    ]
  },
