  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/clone/voice/VOICE_ASSET_ID/parameters \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"emotion\":1,\"speed\":1,\"title\":\"Demo title\",\"tone\":1}'",
