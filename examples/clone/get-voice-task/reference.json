  "hero": {
    "title": "Get Voice Task",
    "summary": "Read the current state of a voice cloning task."
  },
  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/clone/voice/tasks/{task_id}",
    "summary": "Return the current state of a voice cloning task."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Try it requires a task_id returned by a voice operation.",
      "Poll the task after voice clone or parameter edit requests."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "task_id",
        "type": "string",
        "required": true,
        "location": "PATH"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "Application response code.\n\n| Code | Meaning |\n| ---- | ------- |\n| `0` | OK |\n| `13` | Authentication is required |\n| `15` | Resource not found |\n| `99` | Server error |",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "13",
          "15",
          "99"
        ]
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "unauthenticated",
          "not found",
          "server error"
        ]
      }
    ]
  },
