  "hero": {
    "title": "Get Process Task",
    "summary": "Read the current state of a processing task."
  },
  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/process/tasks/{task_id}",
    "summary": "Return the current state of a media processing task."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires a task_id returned by a processing request.",
      "Use this to poll processing workflows."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "task_id",
        "type": "string",
        "required": true,
        "location": "PATH"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "Application response code.\n\n| Code | Meaning |\n| ---- | ------- |\n| `0` | OK |\n| `1404` | Provider returned an error |\n| `1405` | Provider request timed out |\n| `13` | Authentication is required |\n| `15` | Resource not found |\n| `99` | Server error |",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "1404",
          "1405",
          "13",
          "15",
          "99"
        ]
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "provider error",
          "provider timeout",
          "unauthenticated",
          "not found",
          "server error"
        ]
      }
    ]
  },
  "examples": {
    "title": "Examples",
    "request_example": "curl -X GET https://api.medux.io/api/app/v1/process/tasks/TASK_ID \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY'",
    "curl_command": "curl -X GET https://api.medux.io/api/app/v1/process/tasks/TASK_ID \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY'"
