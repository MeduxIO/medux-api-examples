  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/process/video/video_logo_removal \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"input_video_file_id\":\"FILE_ID\",\"logo_type\":\"moving\",\"model_id\":\"video-logo-removal-default\"}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/process/video/video_logo_removal \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"input_video_file_id\":\"FILE_ID\",\"logo_type\":\"moving\",\"model_id\":\"video-logo-removal-default\"}'"
  },
