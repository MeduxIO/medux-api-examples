  "hero": {
    "title": "Create Video Logo Removal",
    "summary": "Remove a logo from a video using an optional logo reference and motion mode."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/process/video/video_logo_removal",
    "summary": "Remove a logo from a video using an optional logo reference and motion mode."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "input_video_file_id",
        "type": "string",
        "required": true,
        "description": "Input video file_id.",
        "location": "BODY"
      },
      {
        "name": "logo_file_id",
        "type": "string",
        "description": "Optional logo image file_id used to build the logo mask session.",
        "location": "BODY"
      },
      {
        "name": "video_size",
        "type": "object",
        "description": "Optional original video size hint as [width, height].",
        "location": "BODY"
      },
      {
        "name": "logo_type",
        "type": "string",
        "description": "Logo motion mode for mask generation. Default: moving. Default: moving.",
        "location": "BODY",
        "enum_values": [
          "moving"
        ],
        "default_value": "moving"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Video logo removal model id. Default: video-logo-removal-default.",
        "location": "BODY",
        "default_value": "video-logo-removal-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "Application response code.\n\n| Code | Meaning |\n| ---- | ------- |\n| `0` | OK |\n| `12` | Invalid input |\n| `1401` | Insufficient credits |\n| `1404` | Provider returned an error |\n| `1405` | Provider request timed out |\n| `13` | Authentication is required |\n| `16` | Rate limit exceeded |\n| `99` | Server error |",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1410",
          "1409",
          "1401",
          "1404",
          "1405",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.paid_plan_required",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
