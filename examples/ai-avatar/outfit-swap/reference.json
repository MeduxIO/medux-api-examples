  "hero": {
    "title": "Image Outfit Swap",
    "summary": "Transfer the outfit from the reference image onto the target subject."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/process/image/outfit_swap",
    "summary": "Transfer the outfit from the reference image onto the target subject."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "source_image_file_id",
        "type": "string",
        "required": true,
        "description": "Source image file_id.",
        "location": "BODY"
      },
      {
        "name": "target_outfit_image_file_id",
        "type": "string",
        "required": true,
        "description": "Target outfit image file_id.",
        "location": "BODY"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Outfit swap model id. Default: image-outfit-swap-default.",
        "location": "BODY",
        "default_value": "image-outfit-swap-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "response code enums:\\\n.. 0: ok\\\n.. 12: invalid input\\\n.. 1410: invalid model\\\n.. 1409: paid plan required\\\n.. 1401: insufficient credits\\\n.... 1401 ~ 1499 是 media\\\n.. 1404: provider error\\\n.. 1405: provider timeout\\\n.. 13: unauthenticated\\\n.. 16: rate limit\\\n.. 99: server error",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1410",
          "1409",
          "1401",
          "1404",
          "1405",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.paid_plan_required",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "invalid model",
          "paid plan required",
          "insufficient credits",
          "provider error",
          "provider timeout",
          "unauthenticated",
          "rate limit",
          "server error"
        ]
      }
    ]
  },
  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/process/image/outfit_swap \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"model_id\":\"image-outfit-swap-default\",\"source_image_file_id\":\"FILE_ID\",\"target_outfit_image_file_id\":\"FILE_ID\"}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/process/image/outfit_swap \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"model_id\":\"image-outfit-swap-default\",\"source_image_file_id\":\"FILE_ID\",\"target_outfit_image_file_id\":\"FILE_ID\"}'",
