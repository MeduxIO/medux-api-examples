    "request_example": "curl -X POST https://api.medux.io/api/app/v1/process/asset/split_pdf \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"input_file_id\":\"FILE_ID\",\"model_id\":\"split-pdf-default\",\"page_range\":\"PAGE_RANGE\"}'",
