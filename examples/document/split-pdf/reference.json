  "hero": {
    "title": "Split PDF",
    "summary": "Extract specific pages from a PDF into a new PDF."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/process/asset/split_pdf",
    "summary": "Extract specific pages from a PDF into a new PDF."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "input_file_id",
        "type": "string",
        "required": true,
        "description": "Input PDF file_id.",
        "location": "BODY"
      },
      {
        "name": "page_range",
        "type": "string",
        "required": true,
        "description": "Page range e.g. 1-3, 1,3,5, or 1-2,5.",
        "location": "BODY"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Model Default: split-pdf-default.",
        "location": "BODY",
        "default_value": "split-pdf-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
