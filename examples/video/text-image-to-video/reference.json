  "hero": {
    "title": "Text & Image to Video",
    "summary": "Generate a video and audio from a text prompt with optional image, last-frame, and audio references."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/generate/video/text_image_to_video",
    "summary": "Generate a video and audio from a text prompt with optional image, last-frame, and audio references."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "prompt_text",
        "type": "string",
        "required": true,
        "description": "Prompt text used to generate the video and audio.",
        "location": "BODY"
      },
      {
        "name": "prompt_image_file_id",
        "type": "string",
        "description": "Optional reference image file_id.",
        "location": "BODY"
      },
      {
        "name": "last_image_file_id",
        "type": "string",
        "description": "Optional last-frame image file_id.",
        "location": "BODY"
      },
      {
        "name": "prompt_audio_file_id",
        "type": "string",
        "description": "Optional driving audio file_id. When set, generated video follows this audio.",
        "location": "BODY"
      },
      {
        "name": "resolution",
        "type": "string",
        "description": "Target output resolution preset. Default: 480p.",
        "location": "BODY",
        "default_value": "480p"
      },
      {
        "name": "num_frames",
        "type": "integer",
        "description": "Number of generated video frames when prompt audio is not set. Default: 124.",
        "location": "BODY",
        "default_value": "124"
      },
      {
        "name": "seed",
        "type": "integer",
        "description": "Random seed. Use -1 to let the pipeline choose one. Default: -1.",
        "location": "BODY",
        "default_value": "-1"
      },
      {
        "name": "height",
        "type": "integer",
        "description": "Optional explicit output height. Default: 832.",
        "location": "BODY",
        "default_value": "832"
      },
      {
        "name": "width",
        "type": "integer",
        "description": "Optional explicit output width. Default: 480.",
        "location": "BODY",
        "default_value": "480"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Text and image to video model id. Default: text-image-to-video-default.",
        "location": "BODY",
        "default_value": "text-image-to-video-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "response code enums:\\\n.. 0: ok\\\n.. 12: invalid input\\\n.. 1410: invalid model\\\n.. 1409: paid plan required\\\n.. 1401: insufficient credits\\\n.... 1401 ~ 1499 是 media\\\n.. 1404: provider error\\\n.. 1405: provider timeout\\\n.. 13: unauthenticated\\\n.. 16: rate limit\\\n.. 99: server error",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1410",
          "1409",
          "1401",
          "1404",
          "1405",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.paid_plan_required",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "invalid model",
          "paid plan required",
          "insufficient credits",
          "provider error",
          "provider timeout",
          "unauthenticated",
          "rate limit",
          "server error"
        ]
      }
    ]
  },
  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/generate/video/text_image_to_video \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"height\":832,\"model_id\":\"text-image-to-video-default\",\"num_frames\":124,\"prompt_text\":\"Hello from Medux\",\"resolution\":\"480p\",\"seed\":-1,\"width\":480}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/generate/video/text_image_to_video \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"height\":832,\"model_id\":\"text-image-to-video-default\",\"num_frames\":124,\"prompt_text\":\"Hello from Medux\",\"resolution\":\"480p\",\"seed\":-1,\"width\":480}'"
  },
