  "hero": {
    "title": "Video Object Removal",
    "summary": "Remove an object from a video by regions."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/process/video/object_removal",
    "summary": "Remove an object from a video by regions."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "input_file_id",
        "type": "string",
        "required": true,
        "description": "Input video file_id.",
        "location": "BODY"
      },
      {
        "name": "regions",
        "type": "object",
        "required": true,
        "description": "Regions to remove, e.g. [[x, y, width, height]]. Default: [[1150, 20, 120, 120]].",
        "location": "BODY",
        "default_value": "[[1150, 20, 120, 120]]"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Model Default: remove-video-object-default.",
        "location": "BODY",
        "default_value": "remove-video-object-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "response code enums:\\\n.. 0: ok\\\n.. 12: invalid input\\\n.. 1410: invalid model\\\n.. 1409: paid plan required\\\n.. 1401: insufficient credits\\\n.... 1401 ~ 1499 是 media\\\n.. 1404: provider error\\\n.. 1405: provider timeout\\\n.. 13: unauthenticated\\\n.. 16: rate limit\\\n.. 99: server error",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1410",
          "1409",
          "1401",
          "1404",
          "1405",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.paid_plan_required",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
