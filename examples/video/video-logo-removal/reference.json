  "hero": {
    "title": "Logo Removal",
    "summary": "Remove a logo from a video using one or more logo references and motion mode."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/process/video/video_logo_removal",
    "summary": "Remove a logo from a video using one or more logo references and motion mode."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Upload the source file and create a file reference before calling this endpoint.",
      "Successful requests return a Medux task record immediately. Use the task query or sync endpoints to track completion.",
      "All file inputs must be uploaded and persisted as file references before submission."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "input_video_file_id",
        "type": "string",
        "required": true,
        "description": "Input video file_id.",
        "location": "BODY"
      },
      {
        "name": "logo_file_id",
        "type": "array<string>",
        "description": "One logo image file_id or a list of logo image file_ids used to build the logo mask session.",
        "location": "BODY"
      },
      {
        "name": "video_size",
        "type": "object",
        "description": "Optional original video size hint as [width, height].",
        "location": "BODY"
      },
      {
        "name": "logo_type",
        "type": "string",
        "description": "Logo motion mode for mask generation. Default: default.",
        "location": "BODY",
        "enum_values": [
          "default",
          "tiktok",
          "heygen",
          "veo",
          "keling",
          "instagram",
          "luma",
          "pika",
          "snapchat",
          "pixverse"
        ],
        "default_value": "default"
      },
      {
        "name": "model_id",
        "type": "string",
        "description": "Video logo removal model id. Default: video-logo-removal-default.",
        "location": "BODY",
        "default_value": "video-logo-removal-default"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Optional task title.",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "response code enums:\\\n.. 0: ok\\\n.. 12: invalid input\\\n.. 1410: invalid model\\\n.. 1409: paid plan required\\\n.. 1401: insufficient credits\\\n.... 1401 ~ 1499 是 media\\\n.. 1404: provider error\\\n.. 1405: provider timeout\\\n.. 13: unauthenticated\\\n.. 16: rate limit\\\n.. 99: server error",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1410",
          "1409",
          "1401",
          "1404",
          "1405",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.paid_plan_required",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "data.task",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "invalid model",
          "paid plan required",
          "insufficient credits",
          "provider error",
          "provider timeout",
          "unauthenticated",
          "rate limit",
          "server error"
        ]
      }
    ]
  },
  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/process/video/video_logo_removal \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"input_video_file_id\":\"FILE_ID\",\"logo_type\":\"default\",\"model_id\":\"video-logo-removal-default\"}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/process/video/video_logo_removal \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"input_video_file_id\":\"FILE_ID\",\"logo_type\":\"default\",\"model_id\":\"video-logo-removal-default\"}'"
  },
