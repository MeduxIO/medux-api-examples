{
  "meta": {
    "page_type": "API_REFERENCE",
    "title": "Create Asset",
    "summary": "Register reusable avatar or voice metadata from an uploaded file. Returns the asset record for asset management and subsequent clone or generation workflows.",
    "module": "infra",
    "endpoint_slug": "create-asset",
    "tags": [
      "Infra",
      "Asset"
    ]
  },
  "hero": {
    "title": "Create Asset",
    "summary": "Register reusable avatar or voice metadata from an uploaded file. Returns the asset record for asset management and subsequent clone or generation workflows."
  },
  "endpoint_summary": {
    "method": "POST",
    "path": "/api/app/v1/assets",
    "summary": "Record an uploaded file as an asset."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires reusable asset metadata.",
      "Uploaded MEDIA files use file_id directly and do not need this endpoint."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "category",
        "type": "string",
        "description": "Asset category, used for validation and later rendering.\\\n\\\n. assethpb.Category:\\\n... enums:\\\n..... CATEGORY_UNDEFINED\\\n..... MEDIA\\\n..... AVATAR\\\n..... VOICE",
        "location": "BODY",
        "enum_values": [
          "CATEGORY_UNDEFINED",
          "MEDIA",
          "AVATAR",
          "VOICE"
        ]
      },
      {
        "name": "file_size_bytes",
        "type": "int64",
        "description": "Original file size in bytes.",
        "location": "BODY"
      },
      {
        "name": "name",
        "type": "string",
        "description": "User-provided display name. It may be empty.",
        "location": "BODY"
      },
      {
        "name": "storage_object.key",
        "type": "string",
        "location": "BODY"
      },
      {
        "name": "storage_object.url",
        "type": "string",
        "location": "BODY"
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "response code enums:\\\n.. 0: ok\\\n.. 12: invalid input\\\n.. 1406: asset limit reached\\\n.. 13: unauthenticated\\\n.. 16: rate limit\\\n.. 99: server error",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "1406",
          "13",
          "16",
          "99"
        ]
      },
      {
        "name": "data.asset",
        "type": "object",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "asset limit reached",
          "unauthenticated",
          "rate limit",
          "server error"
        ]
      }
    ]
  },
  "examples": {
    "title": "Examples",
    "request_example": "curl -X POST https://api.medux.io/api/app/v1/assets \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"category\":\"MEDIA\",\"file_size_bytes\":1,\"name\":\"NAME\",\"storage_object\":{\"key\":\"STORAGE_OBJECT_KEY\",\"url\":\"https://example.com/callback\"}}'",
    "curl_command": "curl -X POST https://api.medux.io/api/app/v1/assets \\\n  -H 'Authorization: Bearer $MEDUX_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"category\":\"MEDIA\",\"file_size_bytes\":1,\"name\":\"NAME\",\"storage_object\":{\"key\":\"STORAGE_OBJECT_KEY\",\"url\":\"https://example.com/callback\"}}'"
  },
  "source_url": "https://medux.io/api-reference/infra/create-asset"
}
