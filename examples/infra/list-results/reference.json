  "hero": {
    "title": "List Results",
    "summary": "List retained media results for the current account."
  },
  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/results",
    "summary": "List saved result records for the authenticated user."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Try it lists retained results for the current account.",
      "Results retention is limited; expired outputs are not returned."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "cursor",
        "type": "string",
        "location": "QUERY"
      },
      {
        "name": "limit",
        "type": "int32",
        "location": "QUERY"
      },
      {
        "name": "media_type",
        "type": "string",
        "location": "QUERY"
      },
      {
        "name": "capability_id",
        "type": "string",
        "location": "QUERY"
      },
      {
        "name": "status",
        "type": "string",
        "description": "Allowed values:\n- `RESULT_STATUS_UNDEFINED` - Not specified.\n- `READY` - Result is ready.\n- `RESULT_PROCESSING` - Result is still processing.\n- `RESULT_FAILED` - Result generation failed.\n- `RESULT_EXPIRED` - Result is expired.",
        "location": "QUERY",
        "enum_values": [
          "RESULT_STATUS_UNDEFINED",
          "READY",
          "RESULT_PROCESSING",
          "RESULT_FAILED",
          "RESULT_EXPIRED"
        ]
      }
    ]
  },
  "response_section": {
    "title": "Response",
    "fields": [
      {
        "name": "code",
        "type": "int32",
        "description": "Application response code.\n\n| Code | Meaning |\n| ---- | ------- |\n| `0` | OK |\n| `12` | Invalid input |\n| `13` | Authentication is required |\n| `99` | Server error |",
        "location": "RESPONSE",
        "enum_values": [
          "0",
          "12",
          "13",
          "99"
        ]
      },
      {
        "name": "data.items",
        "type": "array<object>",
        "location": "RESPONSE"
      },
      {
        "name": "data.next_cursor",
        "type": "string",
        "location": "RESPONSE"
      },
      {
        "name": "data.retention_notice",
        "type": "string",
        "location": "RESPONSE"
      },
      {
        "name": "message",
        "type": "string",
        "location": "RESPONSE",
        "enum_values": [
          "ok",
          "invalid input",
          "unauthenticated",
          "server error"
        ]
      }
    ]
  },
