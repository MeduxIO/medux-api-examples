  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/results",
    "summary": "List retained result records for the current user."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
