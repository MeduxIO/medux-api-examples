  "hero": {
    "title": "Get Task",
    "summary": "Get a single task record from the current account history."
  },
  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/tasks/{task_id}",
    "summary": "Return one task record by its ID."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
  },
  "preconditions": {
    "title": "Preconditions",
    "items": [
      "Requires a task_id from account history or task creation responses.",
      "Useful for account-side history views."
    ]
  },
  "request_section": {
    "title": "Request",
    "fields": [
      {
        "name": "Authorization",
        "type": "string",
        "required": true,
        "description": "Bearer token or API key.",
        "location": "HEADER"
      },
      {
        "name": "task_id",
        "type": "string",
        "required": true,
        "location": "PATH"
      }
    ]
  },
