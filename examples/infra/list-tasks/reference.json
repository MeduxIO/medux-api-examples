  "endpoint_summary": {
    "method": "GET",
    "path": "/api/app/v1/tasks",
    "summary": "List task records for the current user."
  },
  "auth_requirements": {
    "title": "Auth Requirements",
    "items": [
      "Authentication is required via Authorization header."
    ]
