# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The Python and JavaScript examples read these from the environment.

# Required for every request.
MEDUX_API_KEY=your_api_key

# Optional. Overrides the default API host (https://api.medux.io),
# e.g. for a staging environment.
# MEDUX_API_BASE_URL=https://api.medux.io

# Per-endpoint placeholders. Only set the ones an example's README lists.
# Examples (uncomment as needed):
# FILE_ID=your_uploaded_file_id
# TASK_ID=your_task_id
# VOICE_ASSET_ID=your_voice_asset_id
# CURSOR=pagination_cursor
# LIMIT=20
